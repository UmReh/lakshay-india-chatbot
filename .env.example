# This project stores no secrets in code. Credentials are created inside n8n.
# This file only lists what you need to set up. Never commit real values.

# Google Gemini (chat + embeddings) - API key from Google AI Studio
GEMINI_API_KEY=

# Supabase - Project URL (no /rest/v1 at the end) and secret key
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Sheets - OAuth credential created in n8n
# (Google Cloud project with the Sheets API enabled)
GOOGLE_SHEET_ID=
