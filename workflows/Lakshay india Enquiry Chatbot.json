    {
      "parameters": {
        "jsCode": "   const raw = $input.first().json.text ?? '';\n   let d;\n   try {\n     const c = raw.replace(/```json|```/g, '').trim();\n     d = JSON.parse(c.slice(c.indexOf('{'), c.lastIndexOf('}') + 1));\n   } catch (e) {\n     d = { reply: raw, name: '', course_interest: '', lead_status: 'unknown', answer_found: false, next_step: '' };\n   }\n   const start = $('Start Timer').first().json;\n   const question = start.body.message;\n   const context = $('Code in JavaScript').first().json.context ?? '';\n   return [{ json: {\n     text: d.reply ?? raw,\n     reply: d.reply ?? raw,\n     timestamp: new Date().toISOString(),\n     name: d.name ?? '',\n     message: question,\n     course_interest: d.course_interest ?? '',\n     lead_status: String(d.lead_status ?? 'unknown').toLowerCase(),\n     answer_found: d.answer_found === true,\n     next_step: d.next_step ?? '',\n     tokens_in: Math.ceil((context.length + question.length + 1000) / 4),\n     tokens_out: Math.ceil(raw.length / 4),\n     latency_ms: Date.now() - start.startTime,\n     error: ''\n   }}];"
      },
